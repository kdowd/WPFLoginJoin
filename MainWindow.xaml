<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:WPFLoginJoin"
    xmlns:Components="clr-namespace:WPFLoginJoin.Views.Components" x:Class="WPFLoginJoin.MainWindow"
    mc:Ignorable="d"
    Background="Teal"
    Title="MainWindow" Height="600" Width="800" Loaded="OnAppLoaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Components:Login Grid.Column="1" HorizontalAlignment="Left"  VerticalAlignment="Top"/>

    </Grid>
</Window>
