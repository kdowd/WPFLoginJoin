<UserControl x:Class="WPFLoginJoin.Views.Components.CreateAdmin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPFLoginJoin.Views.Components"
             mc:Ignorable="d"
             Background="Snow"
             MinWidth="440" MinHeight="450"
             d:DesignHeight="450" d:DesignWidth="440">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6 12" />
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="Black" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="80"></RowDefinition>
            </Grid.RowDefinitions>

            <Border Padding="20 30">
                <StackPanel>
                    <StackPanel>
                        <Label>Username:</Label>
                        <TextBox></TextBox>
                    </StackPanel>
                    <StackPanel>
                        <Label>Password:</Label>
                        <TextBox></TextBox>
                    </StackPanel>
                    <StackPanel  Orientation="Vertical" Margin="30">
                        <Button Click="OnCreateAdmin" FontFamily="Cascadia Code" FontSize="18" Content="Submit" Padding="30 20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>

                </StackPanel>
            </Border>



            <Rectangle Fill="Black" Grid.Row="1" Panel.ZIndex="0" />
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Panel.ZIndex="1" FontFamily="Cascadia Code" Text="Create New Admin"  Grid.Row="1" Foreground="Snow" />



        </Grid>
    </Border>

</UserControl>
